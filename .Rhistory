library(readr)
library(tidyverse)
library(dplyr)
library(read.dbc)
library(ggplot2)
library(lubridate)
calcula_idade <- function(x){
if(x >= 4000){
idade = x - 4000
}else if(x >= 1000 & x < 4000){
idade = 0
}else{
idade = NaN
}
return(idade)
}
calcula_idade_vec <- Vectorize(calcula_idade)
# Dengue ##################################################################
file_list <- list.files('data/dengue/', pattern = "\\.dbc$", full.names = TRUE)
file_list <- file_list[-2]
df <- data.frame()
for(file in file_list){
print(file)
df_aux <- read.dbc(file)
df_aux <- df_aux %>% filter(CLASSI_FIN %in% c(10, 11, 12))
a <- df_aux %>% filter(ID_MN_RESI == 355030)
b <- df_aux %>% filter(ID_MN_RESI == '355030')
print(a %>% nrow())
df_aux <- df_aux %>% filter(!is.na(NU_IDADE_N))
df_aux <- df_aux %>% mutate(idade = calcula_idade_vec(NU_IDADE_N))
df_aux <- df_aux %>% filter(!is.na(idade))
df_aux <- df_aux %>% mutate(anoepi = epiyear(DT_SIN_PRI))
df_aux <- df_aux %>% mutate(age_group = case_when(
idade >= 0 & idade <= 4 ~ '00 a 04',
idade >= 5 & idade <= 9 ~ '05 a 09',
idade >= 10 & idade <= 14 ~ '10 a 14',
idade >= 15 & idade <= 19 ~ '15 a 19',
idade >= 20 & idade <= 29 ~ '20 a 29',
idade >= 30 & idade <= 39 ~ '30 a 39',
idade >= 40 & idade <= 49 ~ '40 a 49',
idade >= 50 & idade <= 59 ~ '50 a 59',
idade >= 60 & idade <= 69 ~ '60 a 69',
idade >= 70 & idade <= 79 ~ '70 a 79',
idade >= 80 ~ '80 e +'
))
df_aux <- df_aux %>% group_by(anoepi, ID_MN_RESI, age_group) %>% summarise(n = n())
df_aux <- df_aux %>% ungroup()
df <- rbind(df, df_aux)
}
for(file in file_list){
print(file)
df_aux <- read.dbc(file)

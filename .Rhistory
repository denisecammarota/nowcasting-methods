a <- df_aux %>% filter(ID_MN_RESI == 355030)
b <- df_aux %>% filter(ID_MN_RESI == '355030')
print(a %>% nrow())
df_aux <- df_aux %>% filter(!is.na(NU_IDADE_N))
df_aux <- df_aux %>% mutate(idade = calcula_idade_vec(NU_IDADE_N))
df_aux <- df_aux %>% filter(!is.na(idade))
df_aux <- df_aux %>% mutate(anoepi = epiyear(DT_SIN_PRI))

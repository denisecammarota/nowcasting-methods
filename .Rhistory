geom_line(aes(y = logs, color = "logistic")) +
geom_line(aes(y = subs, color = "sublinear")) +
geom_line(aes(y = logsAE, color = "logistic + AE")) +
geom_line(aes(y = subsAE, color = "sublinear + AE")) +
theme_bw() +
xlab('Abundance') +
ylab('dB/dt') +
labs(color = 'C = 0.01')
